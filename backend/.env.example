# Environment
NODE_ENV=development
PORT=5000

# Database (Supabase PostgreSQL / Postgres)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# MongoDB (legacy / optional fallback)
MONGO_URI=mongodb://localhost:27017/asset_platform

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-key-here
JWT_REFRESH_SECRET=change-me-refresh-secret-key-here
ACCESS_TTL=15m
REFRESH_TTL=7d

# Client
CLIENT_ORIGIN=http://localhost:5173

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_BUCKET=assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@assetplatform.io

# AI / LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
LLM_API_KEY=

# Vector store
VECTOR_STORE=atlas
QDRANT_URL=http://qdrant:6333

# Workers
WORKER_CONCURRENCY=5

# Depreciation
DEPRECIATION_YEARS=5

# Seed passwords
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_PASSWORD=User@123
